# Copy to .env and edit. Never commit the real .env — it is gitignored.
#
# Only AUTH_PASSWORD is required. Everything below it is optional, and a
# malformed value stops the app at startup rather than being ignored.

# Required. The password you sign in with. Minimum 8 characters; use a long
# passphrase rather than a clever short one.
AUTH_PASSWORD=change-me-to-a-long-passphrase

# Compose binds only to loopback. Use Tailscale Serve for private phone access.
# TASK_HUB_PORT=8080
# Tag deployment images with the reviewed commit for predictable rollback.
# TASK_HUB_VERSION=latest

# Optional. Lets scripts and cron jobs call the API without a browser session,
# via "Authorization: Bearer <token>" or "X-API-Key: <token>".
# Minimum 16 characters. Generate one with:
#   openssl rand -base64 32
# API_TOKEN=

# Optional. Set to true when serving over HTTPS so the session cookie carries
# the Secure attribute. Leave unset for plain HTTP on a LAN, otherwise the
# browser will discard the cookie and login will appear to silently fail.
# COOKIE_SECURE=true

# Optional. How long a session lasts before requiring another sign-in.
# SESSION_DAYS=30

# Optional. Skip authentication entirely — only sensible when something else
# already authenticates traffic (Authelia, Tailscale, Cloudflare Access).
# Mutually exclusive with AUTH_PASSWORD.
# AUTH_DISABLED=true

# Optional. Turn on ONLY when a reverse proxy really is in front. It makes the
# login lockout and rate limiter read X-Forwarded-For, which is right behind a
# proxy (otherwise every client shares the proxy's address and one attacker
# locks out everyone) and wrong without one (any client can send that header,
# so an attacker could rotate it to guess passwords indefinitely).
# TRUST_PROXY=true

# Optional. Serve /api/health without authentication, for an uptime monitor
# that cannot hold a session. It reports liveness only. The container's own
# HEALTHCHECK does not need this — it treats any HTTP response as alive.
# PUBLIC_HEALTH=true

# Optional. API requests allowed per client per minute; 0 disables the limit.
# Generous enough that a person never sees it and a runaway script does.
# RATE_LIMIT_PER_MINUTE=300

# Optional. debug adds a per-request access log; json suits a log shipper.
# LOG_LEVEL=info
# LOG_FORMAT=text

# ---- Notifications ---------------------------------------------------------
# Optional. Post ticket events to a webhook. Delivery is best-effort: a webhook
# that is down never fails the API request that triggered it.
# NOTIFY_URL=https://ntfy.sh/my-homelab-topic
#
# json posts a JSON body; ntfy sends plain text with headers, as ntfy expects.
# NOTIFY_FORMAT=json
#
# Which events to send. Available: ticket.created, ticket.resolved,
# ticket.overdue, ticket.due_soon, ticket.follow_up, schedule.fired
# NOTIFY_EVENTS=ticket.created,ticket.overdue,schedule.fired
#
# Stay quiet about anything below this priority: low, medium, high, critical
# NOTIFY_MIN_PRIORITY=low
# NOTIFY_TIMEOUT_MS=5000
#
# How many days ahead of a due date to send the ticket.due_soon nudge. Only
# consulted when that event is in NOTIFY_EVENTS; 0 turns the look-ahead off.
# NOTIFY_REMINDER_DAYS=3
#
# A rolled-up summary of the backlog — open, overdue, stale, and what's coming
# up this week — sent at most once per cadence. off, daily, or weekly.
# NOTIFY_DIGEST=weekly

# ---- Backups ---------------------------------------------------------------
# Optional. Setting a directory enables scheduled VACUUM INTO snapshots, which
# are safe against a live database. Only files the app wrote are ever pruned.
# Compose enables daily backups on its separate ticket-backups volume by default.
# Direct Node startup leaves backups off until BACKUP_DIR is set.
# BACKUP_DIR=/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Optional. How often due schedules are turned into tickets, overdue tickets
# are announced, and warranties are checked. Set to 0 to drive it from cron by
# posting to /api/maintenance/run instead.
# MAINTENANCE_INTERVAL_MINUTES=60

# Optional. How many days before a device's warranty lapses to open a ticket
# about it, on the maintenance sweep. 0 disables the warranty check.
# WARRANTY_ALERT_DAYS=30

# Optional. Container timezone, used for due dates and timestamps.
# TZ=Europe/London
# Civil dates for Today, snooze, follow-ups and new routines. Legacy schedules stay UTC.
APP_TIME_ZONE=America/Denver
